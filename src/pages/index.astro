---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://buildmy.house';

const faqs = [
  {
    question: 'Is House Designer really free?',
    answer: "Yes. You can draw a floor plan, furnish it, and view it in 3D at no cost, and there is no credit card to enter. If that changes for any part of the product, we'll say so on the pricing page before it happens.",
  },
  {
    question: 'Do I need to create an account or sign up?',
    answer: 'No. Open the app and start designing right away; there is no account to create and no signup step.',
  },
  {
    question: 'Do I need to download or install anything?',
    answer: 'No. House Designer runs in your web browser, so there is nothing to download or install.',
  },
  {
    question: 'Do I need design experience to use it?',
    answer: 'No. You sketch walls, rooms, doors, and windows on a grid, place furniture from the catalog, and flip to a live 3D view of the same model.',
  },
  {
    question: 'Can I use it to plan a renovation?',
    answer: 'Yes. Sketch the new layout, move the walls that are changing, and see the result in 3D before anything changes in the real room.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'House Designer',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/favicon.svg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: 'House Designer',
    url: `${siteUrl}/`,
    publisher: { '@id': `${siteUrl}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    ],
  },
];
---
<Layout jsonLd={jsonLd}>
  <section class="hero">
    <span class="eyebrow">House Designer — free, browser-based, no signup</span>
    <h1>Free 3D home design and floor plan creator — <em>no download, no signup.</em></h1>
    <div class="hero-copy">
      <div class="hero-text">
        <p>Draw your floor plan, furnish it, and see it in 3D — start designing right now, free, with nothing to install and no account required.</p>
        <div><a class="button" href="https://app.buildmy.house">Start designing — it's free ↗</a></div>
      </div>
      <figure class="hero-visual">
        <img
          src="/screenshots/v2-02-app-room-split.png"
          alt="House Designer split view showing a real room's 2D floor plan on the left and the matching live 3D view on the right"
          width="1600"
          height="1000"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="proof" aria-label="Real design examples from House Designer">
    <span class="eyebrow">Real design examples, not mockups</span>
    <h2>Here's what's really on screen.</h2>
    <p>House Designer is still in active development — some of this UI will keep changing — but every screenshot below is a real capture of the working app, not a concept render.</p>

    <div class="proof-grid">
      <figure>
        <img
          src="/screenshots/v2-01-app-empty-split.png"
          alt="Empty split view in House Designer, ready to start drawing a floor plan"
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption>A blank canvas — start drawing immediately, no setup.</figcaption>
      </figure>
      <figure>
        <img
          src="/screenshots/v2-03-app-plan-view.png"
          alt="2D floor plan view in House Designer, showing walls, rooms, and openings"
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption>The plan view on its own.</figcaption>
      </figure>
      <figure>
        <img
          src="/screenshots/v2-04-app-3d-view.png"
          alt="Live 3D view of a room design, full screen, in House Designer"
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption>The 3D view on its own.</figcaption>
      </figure>
      <figure>
        <img
          src="/screenshots/v2-05-app-catalog-panel.png"
          alt="Furniture catalog panel in House Designer, showing items available to place in a room"
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption>The furniture catalog for filling out a room.</figcaption>
      </figure>
    </div>
  </section>

  <section class="how-it-works" aria-label="How House Designer works">
    <span class="eyebrow">How it works</span>
    <h2>Draw the plan. Arrange the furniture. Walk through it in 3D.</h2>
    <div class="cards">
      <article class="card"><span class="number">01 / PLAN</span><h3>Draw the plan</h3><p>Sketch walls, rooms, doors, and windows on a grid that keeps every measurement honest as you edit.</p></article>
      <article class="card"><span class="number">02 / FURNISH</span><h3>Arrange the furniture</h3><p>Place furniture from the catalog and lay out each room the way you'd actually live in it.</p></article>
      <article class="card"><span class="number">03 / WALK</span><h3>Walk through it in 3D</h3><p>Flip to a live 3D view of the exact same model — no separate export, no waiting.</p></article>
    </div>
  </section>

  <section class="renovation" aria-label="Renovation planning">
    <span class="eyebrow">Renovating? Plan it first.</span>
    <h2>See your renovation before you commit to it.</h2>
    <p>Sketch the new layout, move the walls that are actually moving, and see the result in 3D before a single thing changes in the real room.</p>
  </section>

  <section class="faq" aria-label="Frequently asked questions">
    <span class="eyebrow">FAQ</span>
    <h2>Free, in your browser, no signup — the details.</h2>
    <dl class="faq-list">
      {faqs.map(({ question, answer }) => (
        <div class="faq-item">
          <dt>{question}</dt>
          <dd>{answer}</dd>
        </div>
      ))}
    </dl>
    <div><a class="button" href="https://app.buildmy.house">Start designing — it's free ↗</a></div>
  </section>
</Layout>

<style>
  .hero-copy {
    align-items: center;
  }
  .hero-visual img {
    border: 1px solid var(--line);
    display: block;
    height: auto;
    width: 100%;
  }
  .proof {
    border-top: 1px solid var(--line);
    margin-top: 90px;
    padding-top: 70px;
  }
  .proof h2 {
    margin: 16px 0 20px;
  }
  .proof-grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 40px;
  }
  .proof-grid figure {
    margin: -1px 0 0 -1px;
  }
  .proof-grid img {
    border: 1px solid var(--line);
    display: block;
    height: auto;
    width: 100%;
  }
  .proof-grid figcaption {
    color: var(--muted);
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    margin-top: 10px;
  }
  .how-it-works {
    border-top: 1px solid var(--line);
    margin-top: 90px;
    padding-top: 70px;
  }
  .how-it-works h2 {
    margin: 16px 0 20px;
    max-width: 800px;
  }
  .how-it-works .cards {
    margin-top: 50px;
  }
  .renovation {
    border-top: 1px solid var(--line);
    margin-top: 90px;
    padding: 70px 0 90px;
  }
  .renovation h2 {
    margin: 16px 0 20px;
    max-width: 800px;
  }
  .faq {
    border-top: 1px solid var(--line);
    padding: 70px 0 90px;
  }
  .faq h2 {
    margin: 16px 0 20px;
    max-width: 800px;
  }
  .faq-list {
    margin: 30px 0 40px;
    max-width: 800px;
  }
  .faq-item {
    border-top: 1px solid var(--line);
    padding: 20px 0;
  }
  .faq-item dt {
    font-weight: 600;
  }
  .faq-item dd {
    color: var(--muted);
    margin: 8px 0 0;
  }
  @media (max-width: 900px) {
    .proof-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 700px) {
    .hero-copy {
      grid-template-columns: 1fr;
    }
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
