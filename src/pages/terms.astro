  </section>
</Layout>

<style>
  .legal h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }
  .legal h2 { font-size: 1.3rem; margin: 40px 0 12px; }
  .legal p { margin-bottom: 14px; max-width: 70ch; }
</style>
