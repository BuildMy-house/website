---
import '../style/base.css';

const { title = 'House Designer' } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A calmer way to imagine, plan, and share a home." />
    <title>{title} · House Designer</title>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D655186TKF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-D655186TKF');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="House Designer home">
        <span class="brand-mark">HD</span>
        <span>House Designer</span>
      </a>
      <nav aria-label="Main navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="header-cta" href="/contact">Start designing <span>↗</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} House Designer</span>
      <span>Made for rooms with a point of view.</span>
    </footer>
  </body>
</html>
