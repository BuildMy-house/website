---
import '../style/base.css';

const {
  title = 'House Designer — 3D Home Design, No Download or Signup',
  description = 'Draw your floor plan and see it in 3D right in your browser — no download, no account, no design experience needed. Start free.',
  image = '/screenshots/v2-02-app-room-split.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="House Designer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D655186TKF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-D655186TKF');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="House Designer home">
        <span class="brand-mark">H</span>
        <span>House Designer</span>
      </a>
      <nav aria-label="Main navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="header-cta" href="https://app.buildmy.house">Start designing — it's free <span>↗</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} House Designer · buildmy.house</span>
      <span>Free to design — no credit card required.</span>
    </footer>
  </body>
</html>
