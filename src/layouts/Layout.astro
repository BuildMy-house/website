---
import '../style/base.css';

const SITE_NAME = 'buildmy.house';
const DEFAULT_TITLE = 'Free Browser-Based 3D Home Design Tool';

const {
  title,
  description = 'Browser-based home design: draw your floor plan and see it in 3D right in your browser — no download, no account, no design experience needed. Start free.',
  image = '/og-card.png',
  jsonLd = [],
} = Astro.props;

const pagePart = (title ?? '').trim() || DEFAULT_TITLE;
const pageTitle = pagePart.toLowerCase().endsWith(SITE_NAME.toLowerCase())
  ? pagePart
  : `${pagePart} · ${SITE_NAME}`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/features', label: 'Features' },
  { href: '/templates', label: 'Templates' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="House Designer" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="House Designer: floor plan and 3D view side by side in the browser" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd.map((block: object) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <slot name="head" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D655186TKF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-D655186TKF');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="House Designer home">
        <span class="brand-mark">H</span>
        <span>House Designer</span>
      </a>
      <nav aria-label="Main navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="header-cta" href="https://app.buildmy.house">Start designing — it's free <span>↗</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} House Designer · buildmy.house</span>
      <nav aria-label="Footer navigation"><a href="/blog/">Blog</a> <a href="/privacy/">Privacy</a> <a href="/terms/">Terms</a></nav>
      <span>Free to design — no credit card required.</span>
    </footer>
  </body>
</html>
