---
import '../style/base.css';

const { title = 'Homely' } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Homely is a home design app: sketch a real floor plan, step into a live 3D view, then queue a photoreal render." />
    <title>{title} · Homely</title>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D655186TKF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-D655186TKF');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Homely home">
        <span class="brand-mark">H</span>
        <span>Homely</span>
      </a>
      <nav aria-label="Main navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="header-cta" href="https://app.buildmy.house">Start designing <span>↗</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Homely</span>
      <span>Plan it, walk it, render it.</span>
    </footer>
  </body>
</html>
